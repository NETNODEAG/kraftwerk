{
  "name": "@netnodeag/kraftwerk",
  "version": "0.66.0",
  "description": "Open-source agentic workspace for teams — where people and AI agents get work done together: agents (Claude Code, Codex, Pi), skills, shared knowledge, repeatable workflows, and deterministic verification",
  "keywords": [
    "agents",
    "workflow",
    "orchestration",
    "llm",
    "claude",
    "codex",
    "automation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NETNODEAG/kraftwerk.git",
    "directory": "kraftwerk"
  },
  "homepage": "https://github.com/NETNODEAG/kraftwerk#readme",
  "bugs": {
    "url": "https://github.com/NETNODEAG/kraftwerk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "runner",
    "schema",
    "web/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm run build:web",
    "test": "node --import tsx --test test/*/*.test.ts",
    "test:e2e": "playwright test",
    "gen:client": "tsx scripts/gen-client-routes.ts",
    "build:web": "npm --prefix web install --no-fund --no-audit && npm --prefix web run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.75.1",
    "@agentclientprotocol/codex-acp": "^1.10.0",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@inquirer/prompts": "^8.7.1",
    "ajv": "^8.20.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "bin": {
    "kraftwerk": "bin/kraftwerk.js"
  }
}
