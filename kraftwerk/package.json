{
  "name": "@netnodeag/kraftwerk",
  "version": "0.4.1",
  "description": "Deterministic workflow-as-code framework: agents (persona + model + tools + harness) run in bounded phases on headless CLI harnesses (claude -p, codex exec, pi); code owns the control flow, envelopes + gates judge the results",
  "keywords": [
    "agents",
    "workflow",
    "orchestration",
    "llm",
    "claude",
    "codex",
    "automation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NETNODEAG/kraftwerk.git",
    "directory": "kraftwerk"
  },
  "homepage": "https://github.com/NETNODEAG/kraftwerk#readme",
  "bugs": {
    "url": "https://github.com/NETNODEAG/kraftwerk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "runner",
    "schema",
    "inspector/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:inspector": "npm --prefix inspector install --no-fund --no-audit && npm --prefix inspector run build",
    "prepublishOnly": "npm run build && npm run build:inspector"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@inquirer/prompts": "^8.5.2",
    "ajv": "^8.20.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "yaml": "^2.9.0"
  },
  "bin": {
    "kraftwerk": "bin/kraftwerk.js"
  }
}
