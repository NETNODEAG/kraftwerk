{
  "name": "kraftwerk-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend of the kraftwerk inspector: a Vite+React SPA served by the dependency-free server in src/server/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p remote && vite build && vite build --config vite.remote.config.ts && vite build --config vite.remote.config.ts --mode sw",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material-symbols/font-400": "^0.47.6",
    "@mdxeditor/editor": "^4.5.0",
    "dompurify": "^3.4.17",
    "leaflet": "1.9.4",
    "marked": "^18.2.0",
    "qrcode-generator": "^2.0.4",
    "yaml": "2.9.1"
  }
}
